{
  "manifest_version": 3,
  "name": "Browser Toolkit Helper",
  "version": "2.0.0",
  "description": "Create, edit, import and export custom Browser Toolkit scripts.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Browser Toolkit Helper",
    "default_popup": "popup.html",
    "default_icon": { "128": "toolbox.png" }
  },
  "icons": { "128": "toolbox.png" }
}