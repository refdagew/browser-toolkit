{
  "schemaVersion": 1,
  "id": "remove-character-limits",
  "name": "Character limits",
  "description": "Remove maxlength and minlength from inputs and textareas. Toggle restores original values.",
  "button": {
    "label": "Remove limits",
    "activeLabel": "Restore limits",
    "mode": "toggle"
  },
  "code": "(() => {const key=\"__browserToolkitLimits\";if(window[key]){document.querySelectorAll(\"input,textarea\").forEach(el=>{const v=window[key].get(el);if(!v)return;if(v.max===null)el.removeAttribute(\"maxlength\");else el.setAttribute(\"maxlength\",v.max);if(v.min===null)el.removeAttribute(\"minlength\");else el.setAttribute(\"minlength\",v.min);window[key].delete(el);});delete window[key];return;}const saved=new WeakMap();document.querySelectorAll(\"input,textarea\").forEach(el=>{saved.set(el,{max:el.getAttribute(\"maxlength\"),min:el.getAttribute(\"minlength\")});el.removeAttribute(\"maxlength\");el.removeAttribute(\"minlength\");});window[key]=saved;})();"
}