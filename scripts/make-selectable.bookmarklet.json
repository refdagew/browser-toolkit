{
  "schemaVersion": 1,
  "id": "make-selectable",
  "name": "Text selection & copying",
  "description": "Allow selection and stop common page handlers from blocking it.",
  "button": {
    "label": "Off",
    "activeLabel": "On",
    "mode": "toggle"
  },
  "code": "(() => {const key=\"__browserToolkitSelection\";if(window[key]){[\"copy\",\"cut\",\"contextmenu\",\"selectstart\"].forEach(t=>document.removeEventListener(t,window[key],true));document.getElementById(\"__browserToolkitSelectionStyle\")?.remove();delete window[key];return;}const style=document.createElement(\"style\");style.id=\"__browserToolkitSelectionStyle\";style.textContent=\"*{-webkit-user-select:text!important;user-select:text!important}\";(document.head||document.documentElement).append(style);const handler=e=>e.stopImmediatePropagation();[\"copy\",\"cut\",\"contextmenu\",\"selectstart\"].forEach(t=>document.addEventListener(t,handler,true));window[key]=handler;})();"
}