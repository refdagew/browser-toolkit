{
  "schemaVersion": 1,
  "id": "editaway",
  "name": "Edit page",
  "description": "Temporarily make the current document editable.",
  "button": {
    "label": "Off",
    "activeLabel": "On",
    "mode": "toggle"
  },
  "code": "(() => {const key=\"__browserToolkitEdit\";if(window[key]){document.designMode=window[key].mode;if(document.body){if(window[key].had)document.body.setAttribute(\"contenteditable\",window[key].value);else document.body.removeAttribute(\"contenteditable\");}delete window[key];return;}window[key]={mode:document.designMode,had:!!document.body?.hasAttribute(\"contenteditable\"),value:document.body?.getAttribute(\"contenteditable\")};document.designMode=\"on\";document.body?.setAttribute(\"contenteditable\",\"true\");})();"
}